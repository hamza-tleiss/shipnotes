# Copy to .env in the repo root:   cp .env.example .env
# .env is git-ignored (see .gitignore). Never commit it, never paste it in chat.
#
# Compose reads .env from the directory holding compose.yaml and uses it ONLY
# to interpolate ${VARIABLES} in the compose files. It does not inject these
# into containers; the `environment:` blocks do that explicitly.

# Database password. Used by the db service (POSTGRES_PASSWORD) and by the api
# (inside DATABASE_URL). Generate one:  openssl rand -hex 16
POSTGRES_PASSWORD=change-me

# Your GitHub user name. Images are named ghcr.io/<GITHUB_USER>/shipnotes-<service>.
GITHUB_USER=hamza-tleiss

# Image tag Compose runs and `docker compose build` produces.
# Local development: latest. CI / servers (Module 3): sha-<7 chars of the commit>.
IMAGE_TAG=latest

# Build argument baked into the api image; shown by GET /health and in metrics.
# Local: dev. CI: sha-<7>.
APP_VERSION=dev

# pino log level for the api: debug | info | warn | error
LOG_LEVEL=info
